__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/

# e2e rig: generated/heavy artifacts (regenerated by e2e/setup.sh; in this
# workspace they are symlinks to the shared build). Never committed.
e2e/electrum
e2e/.venv-electrum
e2e/bin
e2e/.run

# The usage-statistics receiver writes its database next to itself, which is
# what happens if you serve scripts/analytics-endpoint/ in place to try it out
# locally (see its README). Real reports, even test ones, are never committed.
scripts/analytics-endpoint/*.sqlite
scripts/analytics-endpoint/*.sqlite-wal
scripts/analytics-endpoint/*.sqlite-shm
